{
  "name": "little-ages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A pixel-art civilization sim where nothing is scripted.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types scripts/sim-headless.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "5.9.2",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4"
  }
}
